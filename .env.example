# Copy this file to .env and fill in your API keys

# OpenWeatherMap API key (https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Default city to load on startup (optional)
DEFAULT_CITY=London

# Flask secret key (change this to a random string)
FLASK_SECRET_KEY=change-me-to-a-random-secret-string

# Set to "true" only during local development – never in production
FLASK_DEBUG=false
